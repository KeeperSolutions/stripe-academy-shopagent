# Kopiraj u .env i popuni tajne. .env se nikad ne commita.
# Ovaj popis mora biti u paru sa src/shopagent/config.py.

# --- LLM (D1-D3, D9) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small

# --- Infrastruktura (D3, D6) ---
DATABASE_URL=postgresql+psycopg://shopagent:shopagent@localhost:5432/shopagent
APP_BASE_URL=http://localhost:8000

# --- Commerce (D6-D7) ---
CURRENCY=usd
SHOPAGENT_API_KEY=dev-local-key

# --- Stripe (D7-D8) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Langfuse (D10) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
