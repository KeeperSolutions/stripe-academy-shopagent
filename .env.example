# Copy to .env and fill in the secrets. .env is never committed.
# This list must stay in step with src/shopagent/config.py.

# --- LLM (D1-D3, D9) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Sent only alongside function tools. gpt-5.6-luna rejects tools on
# /v1/chat/completions unless this is 'none'. Leave blank for a model that does
# not know the parameter (e.g. gpt-4o-mini), which 400s if it is sent.
OPENAI_REASONING_EFFORT=none
EMBEDDING_MODEL=text-embedding-3-small

# --- MCP (D4-D5) ---
# false runs the agent with the local tools only, without the catalog server.
MCP_CATALOG_ENABLED=true
# true replaces the `query` argument in the catalog server's log with a salted
# digest: enough to tell two calls apart, not enough to read what was typed.
# Set false only on your own machine, to read back what the model searched for.
MCP_LOG_REDACT_QUERY=true

# --- Infrastructure (D3, D6) ---
DATABASE_URL=postgresql+psycopg://shopagent:shopagent@localhost:5432/shopagent
APP_BASE_URL=http://localhost:8000

# --- Commerce (D6-D7) ---
CURRENCY=usd
SHOPAGENT_API_KEY=dev-local-key

# --- Stripe (D7-D8) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Langfuse (D10) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
