# Copy to .env and fill in the secrets. .env is never committed.
# This list must stay in step with src/shopagent/config.py.

# --- LLM (D1-D3, D9) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# How long one model request may take, and how many times the SDK retries.
# The SDK's own defaults are read=600s with two retries, which turns a dropped
# connection into a thirty-minute silence — measured on a D10 eval pass that
# hung for ten minutes before it was killed.
#
# A dead connection is given up on within (10 + 90) x 3 = 300 seconds. That
# bounds a stall, not a request: these are per-phase inactivity timeouts, so a
# response that trickles can outlast them and retry backoff is on top.
# To shorten it, lower OPENAI_MAX_RETRIES before OPENAI_READ_TIMEOUT_SECONDS:
# the retries are the dominant term, and a shorter read starts cutting off
# answers that were going to arrive.
OPENAI_CONNECT_TIMEOUT_SECONDS=10
OPENAI_READ_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2
# Sent only alongside function tools. gpt-5.6-luna rejects tools on
# /v1/chat/completions unless this is 'none'. Leave blank for a model that does
# not know the parameter (e.g. gpt-4o-mini), which 400s if it is sent.
OPENAI_REASONING_EFFORT=none
EMBEDDING_MODEL=text-embedding-3-small

# --- MCP (D4-D5) ---
# false runs the agent with the local tools only, without the catalog server.
MCP_CATALOG_ENABLED=true
# true replaces the `query` argument in the catalog server's log with a salted
# digest: enough to tell two calls apart, not enough to read what was typed.
# Set false only on your own machine, to read back what the model searched for.
MCP_LOG_REDACT_QUERY=true
# true puts the catalog server's `ping` diagnostic back into the tool list the
# model reads. Off by default: it has no commercial meaning, and every name in
# that list the model has to rule out costs it a decision. Turn it on when
# debugging, to tell "the server is unreachable" apart from "the catalog is
# broken".
MCP_EXPOSE_PING=false

# --- Infrastructure (D3, D6) ---
DATABASE_URL=postgresql+psycopg://shopagent:shopagent@localhost:5432/shopagent
APP_BASE_URL=http://localhost:8000

# --- Commerce (D6-D7) ---
# The shop's currency, ISO-4217 and lowercase. Changing it after the catalog
# is seeded means a reseed: `prices` rows carry the currency they were written
# with, and nothing converts them.
CURRENCY=eur
# Required — the commerce API refuses to start without it, and there is no
# default, because a default would be a shared secret published in this file.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SHOPAGENT_API_KEY=CHANGE-ME
# Where the agent's cart and checkout tools (D9) reach that API. Separate from
# APP_BASE_URL, which is the public URL Stripe redirects a browser to: the two
# are the same string on one machine and stop being one the moment the API sits
# behind a tunnel or a compose network.
COMMERCE_API_BASE_URL=http://localhost:8000
# Where Stripe Checkout sends the shopper back. Both default to APP_BASE_URL
# with a sensible path, so leave them blank while everything runs locally.
# The success URL must keep {CHECKOUT_SESSION_ID} if you override it.
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
# Where the browser interface runs, so the page Stripe redirects to can offer a
# way back to it. A separate server on a separate port from the API above, and
# a third URL because it is a third thing. The link is a fallback: the payment
# button opens Stripe in a new tab, so the conversation is usually still in the
# tab behind, and following the link starts a new one with an empty transcript.
UI_BASE_URL=http://localhost:8501

# --- The agent (D9) ---
# Who the CLI shops as, and the key of the profile it remembers between
# conversations (name, sizes, favourite sections). Leave it blank and the agent
# runs with no long-term memory, which is not an error — nothing is stored and
# nothing is injected into the prompt. Set it to anything you like: it is a
# label, not a credential, and it authenticates nobody.
SHOPPER_ID=

# --- Stripe (D7-D8) ---
STRIPE_SECRET_KEY=
# The signing secret webhook deliveries are verified against. Printed by
# `stripe listen --forward-to localhost:8000/webhooks/stripe`, and shown on the
# endpoint's page in the dashboard. Begins whsec_ — anything else is refused
# when configuration is read, because the API key pasted here would make every
# delivery fail verification with nothing in the log naming the cause.
# Leave blank and POST /webhooks/stripe answers 503; nothing else is affected.
STRIPE_WEBHOOK_SECRET=

# --- Langfuse (D10) ---
# Both keys optional. Missing keys mean tracing quietly does not happen and
# nothing else changes — observability is one part of this system, not a
# precondition for the rest, the same call `STRIPE_SECRET_KEY` gets. The
# CLI says so once in its banner so nobody demos an untraced session
# believing otherwise.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Whether free text is replaced with a salted digest before a trace leaves
# this process. Default true — the same bargain MCP_LOG_REDACT_QUERY
# offers, and a stronger version of it: that log stays on this disk, while
# a trace goes to a third party over the network.
#
# It covers every field a person wrote, not only the search `query`: the
# customer's messages, the model's prose, and the system prompt, which
# carries `display_name` from the profile. Redacting the tool argument
# while sending the sentence it came from would be theatre.
#
# Off, on your own machine, when you need to read a trace as a
# conversation. What you get back is 'what did the customer say' and 'what
# did the model understand'; what you keep either way is the cost, the
# tools and their order, the guardrails and the latencies.
TRACE_REDACT_TEXT=true

# --- The browser UI (D11) ---
# What one browser session may spend on model calls before the shop stops
# answering it. A browser is clicked faster than a terminal is typed into,
# and nothing else in this system stops a person from holding down Send.
#
# D10 measured a whole ten-scenario eval pass at $0.0117, so the default of
# $0.50 is about forty such passes — past any honest demonstration and short
# of a bill worth noticing.
#
# Checked at the door of a turn, never inside one: a turn that starts under
# the cap runs to its end, so the real ceiling is the cap plus one turn.
UI_SPEND_CAP_USD=0.50
